# Copie para a VPS em /etc/fabiju/web.env e preencha.
# NUNCA comite com valor real.

# DEVE ser idêntico ao Jwt__SecretKey da API (o middleware proxy.ts valida a
# assinatura do JWT). Use o MESMO valor — confirmado idêntico em auditoria.
JWT_SECRET=__MESMA_CHAVE_DO_Jwt__SecretKey_DA_API__

# URL interna da API. O padrão já é http://127.0.0.1:5162 — só descomente se mudar.
# API_URL=http://127.0.0.1:5162
