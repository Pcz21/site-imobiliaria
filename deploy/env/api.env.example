# Copie para a VPS em /etc/fabiju/api.env e preencha os __PLACEHOLDERS__.
# NUNCA comite este arquivo com valores reais (segredos).
# Pegue os valores reais do seu ambiente local:  dotnet user-secrets list
#   (na pasta ApiImobiliaria/ApiImobiliaria)

ConnectionStrings__DefaultConnection=Server=127.0.0.1,1433;Database=ImobiliariaDb;User Id=sa;Password=__SENHA_DO_SQL__;TrustServerCertificate=True

Jwt__SecretKey=__MESMA_CHAVE_DO_JWT_SECRET_DO_NEXT__
Jwt__Issuer=ImobiliariaApi
Jwt__Audience=ImobiliariaFrontend
Jwt__ExpiracaoHoras=24

# Contas que podem logar (dev + corretora). Hashes BCrypt vêm do user-secrets.
CredenciaisIniciais__0__Email=spaulo456.com@gmail.com
CredenciaisIniciais__0__SenhaHash=__HASH_BCRYPT_DEV__
CredenciaisIniciais__1__Email=corretora.fabiju243454@gmail.com
CredenciaisIniciais__1__SenhaHash=__HASH_BCRYPT_CORRETORA__

CORS_ALLOWED_ORIGINS=https://fabijuimoveis.com.br,https://www.fabijuimoveis.com.br

# Cloudflare R2 (storage de fotos/vídeos)
R2__AccountId=__R2_ACCOUNT_ID__
R2__AccessKeyId=__R2_ACCESS_KEY__
R2__SecretAccessKey=__R2_SECRET__
R2__Bucket=fabiju-imoveis
R2__PublicBaseUrl=__URL_PUBLICA_DO_R2__
